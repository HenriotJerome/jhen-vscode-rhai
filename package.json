{
	"name": "vscode-rhai-support",
	"displayName": "Rhai highlighting, outline and language configuration",
	"description": "Syntax highlighting, outline and language configuration for Rhai scripts",
	"version": "2026.4.8",
	"publisher": "jhenriotaliaslemeran81",
	"author": {
		"name": "jhenriot alias lemeran81"
	},
	"license": "MIT",
	"icon": "icons/rhai-light.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/HenriotJerome/jhen-vscode-rhai.git"
	},
	"engines": {
		"vscode": "^1.126.0"
	},
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"rhai",
		"scripting",
		"rust"
	],
	"main": "./out/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "rhai",
				"aliases": [
					"Rhai",
					"rhai"
				],
				"extensions": [
					".rhai"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"light": "./icons/rhai-light.png",
					"dark": "./icons/rhai-light.png"
				}
			}
		],
		"grammars": [
			{
				"language": "rhai",
				"scopeName": "source.rhai",
				"path": "./syntaxes/rhai.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "rhai",
				"path": "./snippets/rhai.json"
			}
		],
		"configuration": {
			"title": "Rhai",
			"properties": {
				"rhai.format.enable": {
					"type": "boolean",
					"default": true,
					"description": "%rhai.format.enable.description%"
				},
				"rhai.navigation.searchSubdirectories": {
					"type": "boolean",
					"default": true,
					"description": "%rhai.navigation.searchSubdirectories.description%"
				},
				"rhai.navigation.nativeApi": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"**/rhai-defs/api.json"
					],
					"description": "%rhai.navigation.nativeApi.description%"
				},
				"rhai.navigation.nativeDefinitions": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"**/rhai-defs/api.d.rhai"
					],
					"description": "%rhai.navigation.nativeDefinitions.description%"
				},
				"rhai.diagnostics.enable": {
					"type": "boolean",
					"default": true,
					"description": "%rhai.diagnostics.enable.description%"
				},
				"rhai.navigation.nativeApiPriority": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%rhai.navigation.nativeApiPriority.description%"
				},
				"rhai.host.regenerateCommand": {
					"type": "string",
					"default": "",
					"description": "%rhai.host.regenerateCommand.description%"
				},
				"rhai.inlayHints.enable": {
					"type": "boolean",
					"default": true,
					"description": "%rhai.inlayHints.enable.description%"
				}
			}
		},
		"commands": [
			{
				"command": "rhai.regenerateHostDefinitions",
				"title": "%command.regenerate.title%"
			},
			{
				"command": "rhai.validateHostContract",
				"title": "%command.validate.title%"
			}
		],
		"walkthroughs": [
			{
				"id": "rhai.getStarted",
				"title": "%walkthrough.title%",
				"description": "%walkthrough.description%",
				"steps": [
					{
						"id": "openFile",
						"title": "%walkthrough.openFile.title%",
						"description": "%walkthrough.openFile.description%"
					},
					{
						"id": "configureHost",
						"title": "%walkthrough.configureHost.title%",
						"description": "%walkthrough.configureHost.description%"
					},
					{
						"id": "navigate",
						"title": "%walkthrough.navigate.title%",
						"description": "%walkthrough.navigate.description%"
					},
					{
						"id": "diagnostics",
						"title": "%walkthrough.diagnostics.title%",
						"description": "%walkthrough.diagnostics.description%"
					}
				]
			}
		]
	},
	"private": true,
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"test": "npm run compile && node --test \"test/*.test.js\"",
		"package": "npx vsce package",
		"publish": "ovsx publish",
		"publish:marketplace": "npx vsce publish"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/vscode": "~1.125.0",
		"@vscode/vsce": "^4.1.0",
		"ovsx": "^1.3.0",
		"typescript": "^7.0.2"
	},
	"allowScripts": {
		"@vscode/vsce-sign@2.1.0": true
	},
	"galleryBanner": {
		"color": "#1e1e2e",
		"theme": "dark"
	}
}
