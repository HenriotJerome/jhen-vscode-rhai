{
	"name": "vscode-rhai-support",
	"displayName": "Rhai highlighting, outline and language configuration",
	"description": "Syntax highlighting, outline and language configuration for Rhai scripts",
	"version": "2026.3.1",
	"publisher": "jhenriotaliaslemeran81",
	"author": {
		"name": "jhenriot alias lemeran81"
	},
	"license": "MIT",
	"icon": "icons/rhai-light.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/HenriotJerome/jhen-vscode-rhai.git"
	},
	"engines": {
		"vscode": "^1.126.0"
	},
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"rhai",
		"scripting",
		"rust"
	],
	"main": "./out/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "rhai",
				"aliases": [
					"Rhai",
					"rhai"
				],
				"extensions": [
					".rhai"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"light": "./icons/rhai-light.png",
					"dark": "./icons/rhai-light.png"
				}
			}
		],
		"grammars": [
			{
				"language": "rhai",
				"scopeName": "source.rhai",
				"path": "./syntaxes/rhai.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "rhai",
				"path": "./snippets/rhai.json"
			}
		],
		"configuration": {
			"title": "Rhai",
			"properties": {
				"rhai.format.enable": {
					"type": "boolean",
					"default": true,
					"description": "Active le formateur Rhai (Shift+Alt+F)"
				},
				"rhai.navigation.searchSubdirectories": {
					"type": "boolean",
					"default": true,
					"description": "Recherche les modules importés et les définitions (fonctions, constantes) dans les sous-répertoires du workspace pour la navigation inter-fichiers"
				},
				"rhai.navigation.nativeApi": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"**/rhai-defs/api.json"
					],
					"description": "Fichiers JSON de définitions des fonctions natives Rust (hover)"
				},
				"rhai.navigation.nativeDefinitions": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"**/rhai-defs/api.d.rhai"
					],
					"description": "Fichiers .d.rhai de définitions des fonctions natives Rust (Ctrl+Click)"
				},
				"rhai.diagnostics.enable": {
					"type": "boolean",
					"default": true,
					"description": "Active les diagnostics Rhai (erreurs de syntaxe, symboles inutilisés, code inatteignable)"
				}
			}
		}
	},
	"private": true,
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"test": "npm run compile && node --test test/",
		"package": "npx vsce package",
		"publish": "ovsx publish",
		"publish:marketplace": "npx vsce publish"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/vscode": "~1.125.0",
		"@vscode/vsce": "^4.1.0",
		"typescript": "^7.0.2"
	},
	"allowScripts": {
		"@vscode/vsce-sign@2.1.0": true
	}
}
