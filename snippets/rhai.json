{
	"Rhai Function": {
		"prefix": "fn",
		"body": [
			"/// ${3:Description}",
			"///",
			"/// # Arguments",
			"///",
			"/// * `${2:param}` - ${2:Description}",
			"///",
			"/// # Returns",
			"///",
			"/// ${4:Return description}",
			"fn ${1:name}($2) {",
			"\t$0",
			"}"
		],
		"description": "Fonction Rhai avec documentation"
	},
	"Rhai Const": {
		"prefix": "const",
		"body": [
			"const ${1:NAME} = $0;"
		],
		"description": "Constante Rhai"
	},
	"Rhai Region": {
		"prefix": "region",
		"body": [
			"// region: ${1:Nom de la région}",
			"$0",
			"// endregion: ${1:Nom de la région}"
		],
		"description": "Région avec marqueurs de pliage"
	},
	"Rhai Import": {
		"prefix": "import",
		"body": [
			"import \"${1:module}\" as ${2:alias};"
		],
		"description": "Import de module Rhai"
	},
	"Rhai Object Map": {
		"prefix": "map",
		"body": [
			"#{",
			"\t\"${1:key}\": ${2:value}$0",
			"}"
		],
		"description": "Object map Rhai"
	},
	"Rhai Closure": {
		"prefix": "closure",
		"body": [
			"|${1:params}| { $0 }"
		],
		"description": "Closure Rhai"
	},
	"Rhai For Loop": {
		"prefix": "for",
		"body": [
			"for ${1:item} in ${2:collection} {",
			"\t$0",
			"}"
		],
		"description": "Boucle for Rhai"
	},
	"Rhai If Else": {
		"prefix": "if",
		"body": [
			"if ${1:condition} {",
			"\t$0",
			"} else {",
			"\t",
			"}"
		],
		"description": "Condition if/else Rhai"
	}
}
